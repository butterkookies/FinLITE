# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API (for FinLITE AI Co-Pilot)
GEMINI_API_KEY=your-gemini-api-key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Identity Services (Client-side GIS for "Continue to FinLITE" popup)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Resend Email Configuration (High Inbox Deliverability)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="FinLITE System" <onboarding@resend.dev>

# Dedicated Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=finlite.pdm@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="FinLITE System" <finlite.pdm@gmail.com>
