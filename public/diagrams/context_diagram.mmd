flowchart TD
    classDef sys fill:#064e3b,stroke:#022c22,stroke-width:2px,color:#fff;
    classDef ent fill:#1e293b,stroke:#0f172a,stroke-width:1.5px,color:#fff;

    %% 6 External Entities (Paraan 2: Detailed Real-World Entities)
    STUDENT["Students & Event Participants"]:::ent
    SELLERS["Student Sellers & Booth Concessionaires"]:::ent
    OFFICERS["LITE Executive Officers & Committees"]:::ent
    ADVISERS["Faculty Club Advisers"]:::ent
    ADMIN["BSIT Program Director & CCS Dean"]:::ent
    VENDORS["Suppliers & Stores (Commercial & Informal)"]:::ent

    SYS(("0.0<br/>Existing LITE Manual<br/>Financial Management &<br/>Reporting System")):::sys

    %% 1. Students & Event Participants (Events & Ad-hoc Merch - Pure Inflow / Source Only)
    STUDENT -->|"Event registration fees & ad-hoc merch payments"| SYS

    %% 2. Student Sellers & Booth Concessionaires (Arkila & Percentage Sharing - Pure Inflow / Source Only)
    SELLERS -->|"Booth rental fees ('arkila') & sales percentage remittances"| SYS

    %% 3. Executive Officers (Abono & Petty Expenses)
    OFFICERS -->|"Abono details, purchase receipts & expense slips"| SYS
    SYS -->|"Cash reimbursement payout"| OFFICERS

    %% 4. Faculty Club Advisers
    ADVISERS -->|"Personal advance details & activity spending approval"| SYS
    SYS -->|"Cash reimbursement payout & draft financial report"| ADVISERS

    %% 5. Vendors & Suppliers
    SYS -->|"Disbursement cash payment"| VENDORS
    VENDORS -->|"Sales invoices & handwritten fare/stall slips"| SYS

    %% 6. Department Administration
    SYS -->|"Printed multi-page financial report"| ADMIN
    ADMIN -->|"Signed approval clearance OR rejection directive"| SYS
