flowchart LR
    classDef sys fill:#064e3b,stroke:#022c22,stroke-width:2px,color:#fff;
    classDef ent fill:#1e293b,stroke:#0f172a,stroke-width:1.5px,color:#fff;

    %% ========================================================
    %% PHASE 1: INFLOW SOURCES (Left - Start of Academic Cycle)
    %% ========================================================
    STUDENT["Students & Event Participants"]:::ent
    SELLERS["Student Sellers & Booth Concessionaires"]:::ent

    %% ========================================================
    %% CORE SYSTEM PROCESS (Center)
    %% ========================================================
    SYS(("0.0<br/>Existing LITE Manual<br/>Financial Management &<br/>Reporting System")):::sys

    %% ========================================================
    %% PHASE 2: OPERATIONS & REIMBURSEMENTS (Center / Vertical)
    %% ========================================================
    VENDORS["Suppliers & Stores<br/>(Commercial & Informal)"]:::ent
    OFFICERS["LITE Executive Officers<br/>& Committees"]:::ent
    ADVISERS["Faculty Club Advisers"]:::ent

    %% ========================================================
    %% PHASE 3: ADMINISTRATIVE CLEARANCE (Right - End of Term)
    %% ========================================================
    ADMIN["BSIT Program Director<br/>& CCS Dean"]:::ent

    %% --------------------------------------------------------
    %% 1. Inflow Data Flows (Left to Center) - Pure Sources
    %% --------------------------------------------------------
    STUDENT -->|"Tournament and event registration fees"| SYS
    STUDENT -->|"Merchandise pre-order payments"| SYS
    SELLERS -->|"Booth rental fees ('arkila')"| SYS
    SELLERS -->|"Sales commission remittances"| SYS

    %% --------------------------------------------------------
    %% 2. Procurement Data Flows (System to Vendors)
    %% --------------------------------------------------------
    SYS -->|"Disbursement cash payment"| VENDORS
    VENDORS -->|"Commercial sales invoices"| SYS
    VENDORS -->|"Handwritten fare and stall slips"| SYS

    %% --------------------------------------------------------
    %% 3. Executive Officer Advances & Settlements
    %% --------------------------------------------------------
    OFFICERS -->|"Abono reimbursement claims"| SYS
    OFFICERS -->|"Official receipts and expense slips"| SYS
    SYS -->|"Cash reimbursement payout"| OFFICERS

    %% --------------------------------------------------------
    %% 4. Faculty Adviser Advances, Governance & Review
    %% --------------------------------------------------------
    ADVISERS -->|"Activity spending approvals"| SYS
    ADVISERS -->|"Personal advance (abono) claims"| SYS
    SYS -->|"Cash reimbursement payout"| ADVISERS
    SYS -->|"Draft financial report for review"| ADVISERS

    %% --------------------------------------------------------
    %% 5. Department Administrative Clearance (Center to Right)
    %% --------------------------------------------------------
    SYS -->|"Printed multi-page financial report"| ADMIN
    ADMIN -->|"Signed financial clearance"| SYS
    ADMIN -->|"Report revision directive"| SYS
