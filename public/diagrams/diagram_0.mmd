flowchart TD
    classDef proc fill:#0f766e,stroke:#115e59,stroke-width:1.5px,color:#fff;
    classDef ent fill:#1e293b,stroke:#0f172a,stroke-width:1.5px,color:#fff;
    classDef store fill:#fef3c7,stroke:#d97706,stroke-width:1.5px,color:#78350f;

    %% ========================================================
    %% EXTERNAL ENTITIES (Strictly Balanced with Context Diagram)
    %% ========================================================
    STUDENT["Students & Event Participants"]:::ent
    SELLERS["Student Sellers & Booth Concessionaires"]:::ent
    OFFICERS["LITE Executive Officers & Committees"]:::ent
    ADVISERS["Faculty Club Advisers"]:::ent
    VENDORS["Suppliers & Stores (Commercial & Informal)"]:::ent
    ADMIN["BSIT Program Director & CCS Dean"]:::ent

    %% ========================================================
    %% DATA STORES (Physical Repositories of Current System)
    %% ========================================================
    D1[("D1: Small Metal Cashbox<br/>(Program Director's Room)")]:::store
    D2[("D2: Personal GCash Accounts<br/>(Treasurer / On-Duty Officer)")]:::store
    D3[("D3: Loose Paper Receipts & Expense Slips<br/>(Envelopes / Folders)")]:::store
    D4[("D4: Manual Excel & Word Drafts<br/>(Treasurer's Laptop)")]:::store

    %% ========================================================
    %% SUB-PROCESSES (4-Phase Chronological Lifecycle)
    %% ========================================================
    P1(("1.0<br/>Event, Merch &<br/>Booth Fee Collection")):::proc
    P2(("2.0<br/>Personal Advance (Abono)<br/>& Petty Cash<br/>Disbursement")):::proc
    P3(("3.0<br/>End-of-Term Cash<br/>Count & Variance<br/>Reconciliation")):::proc
    P4(("4.0<br/>Manual Financial Report<br/>Drafting & 6-Tier<br/>Wet-Ink Routing")):::proc

    %% --------------------------------------------------------
    %% PHASE 1: INFLOW COLLECTIONS (Start of Term / Pre-Event)
    %% --------------------------------------------------------
    STUDENT -->|"Tournament and event registration fees"| P1
    STUDENT -->|"Merchandise pre-order payments"| P1
    SELLERS -->|"Booth rental fees ('arkila')"| P1
    SELLERS -->|"Sales commission remittances"| P1

    P1 -->|"Remit collected physical currency"| D1
    P1 -->|"Record digital GCash wallet balance"| D2
    D2 -->|"Liquidated cash remittance"| P1

    %% --------------------------------------------------------
    %% PHASE 2: ABONO & OPERATING DISBURSEMENTS (Mid-Term)
    %% --------------------------------------------------------
    OFFICERS -->|"Abono reimbursement claims"| P2
    OFFICERS -->|"Official receipts and expense slips"| P2
    P2 -->|"Cash reimbursement payout"| OFFICERS

    ADVISERS -->|"Activity spending approvals"| P2
    ADVISERS -->|"Personal advance (abono) claims"| P2
    P2 -->|"Cash reimbursement payout"| ADVISERS

    P2 -->|"Disbursement cash payment"| VENDORS
    VENDORS -->|"Commercial sales invoices"| P2
    VENDORS -->|"Handwritten fare and stall slips"| P2

    D1 -->|"Disburse cash for settlement"| P2
    P2 -->|"Archive physical receipts and slips"| D3

    %% --------------------------------------------------------
    %% PHASE 3: CASHBOX RECONCILIATION (Post-Event / End of Term)
    %% --------------------------------------------------------
    D1 -->|"Count physical bills and coins"| P3
    D3 -->|"Retrieve paper receipts and expense slips"| P3
    P3 -->|"Tally book ledger records"| D4
    P3 -->|"Record allowable ₱161 shortage"| D4

    %% --------------------------------------------------------
    %% PHASE 4: FINANCIAL REPORT CLEARANCE (End of Academic Cycle)
    %% --------------------------------------------------------
    D4 -->|"Compile financial report data"| P4
    P4 -->|"Draft financial report for review"| ADVISERS
    ADVISERS -->|"Financial report verification"| P4
    P4 -->|"Printed multi-page financial report"| ADMIN
    ADMIN -->|"Report revision directive"| P4
    ADMIN -->|"Signed financial clearance"| D4
