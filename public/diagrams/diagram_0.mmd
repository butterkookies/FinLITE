flowchart TD
    classDef proc fill:#0f766e,stroke:#115e59,stroke-width:1.5px,color:#fff;
    classDef ent fill:#1e293b,stroke:#0f172a,stroke-width:1.5px,color:#fff;
    classDef store fill:#fef3c7,stroke:#d97706,stroke-width:1.5px,color:#78350f;

    STUDENT["Students / Payors"]:::ent
    CLAIMANT["Faculty Advisers & Officers"]:::ent
    VENDORS["Vendors / Transport Drivers"]:::ent
    ADMIN["BSIT Director & CCS Dean"]:::ent

    D1[("D1: Small Metal Cashbox<br/>(Program Director's Room)")]:::store
    D2[("D2: Personal GCash Accounts<br/>(Treasurer / On-duty Officer)")]:::store
    D3[("D3: Loose Paper Slips & Receipts<br/>(Envelopes / Folders)")]:::store
    D4[("D4: Manual Excel & Word Drafts<br/>(Treasurer's Laptop)")]:::store

    P1(("1.0<br/>Fee Collection &<br/>GCash Pooling")):::proc
    P2(("2.0<br/>Personal Advance<br/>(Abono) & Petty<br/>Disbursement")):::proc
    P3(("3.0<br/>End-of-Term Cash<br/>Count & Variance<br/>Reconciliation")):::proc
    P4(("4.0<br/>Manual Report<br/>Drafting & 6-Tier<br/>Wet-Ink Routing")):::proc

    STUDENT -->|"Cash dues & merch fees"| P1
    STUDENT -->|"Digital GCash payments"| P1
    P1 -->|"Deposit physical bills/coins"| D1
    P1 -->|"Accumulate digital balance"| D2
    D2 -->|"Manual cash-out (minus ₱15-20 fee)"| P1

    CLAIMANT -->|"Advance personal funds for urgent supplies"| P2
    P2 -->|"Cash payment"| VENDORS
    VENDORS -->|"Paper ORs & handwritten fare slips"| P2
    P2 -->|"Store crumpled/faded receipts"| D3
    D1 -->|"Extract physical cash for reimbursement"| P2
    P2 -->|"Delayed cash refund"| CLAIMANT

    D1 -->|"Extract physical bills & coins"| P3
    D3 -->|"Retrieve loose paper expense slips"| P3
    P3 -->|"Tally mental math & declare ₱161 shortage or officer abono"| D4

    D4 -->|"Compile figures into Times New Roman layout"| P4
    P4 -->|"Printed hard copy on bond paper"| ADMIN
    ADMIN -->|"Rejection due to layout/math error"| P4
    ADMIN -->|"Final signed clearance"| D4
